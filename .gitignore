# ==============================================================================
# Frontend (.gitignore for React / Vite / Tailwind)
# ==============================================================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies & Build Output
node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables & secrets
.env
.env.*
!.env.example
*.env

# Vite temporary files
*.timestamp-*.mjs
*.timestamp-*.js

# TypeScript
*.tsbuildinfo

# Testing & Coverage
coverage/
.nyc_output/

# Cache & Build
.turbo/
.cache/
.parcel-cache/

# OS and Temporary files
Thumbs.db
*.bak
temp/
tmp/
scratch/

# Firebase & Deployment logs
firebase-debug.log*
.firebase/

# Workspace & Agents
.agents/
graphify-out/
